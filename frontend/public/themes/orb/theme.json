{
  "id": "orb",
  "name": "星尘 · 点阵球",
  "desc": "光点构成的思考球：随指针旋转、被磁场推开，点击泛起涟漪",
  "page": "themes/orb/orb.html",
  "thumb": "url(/thumbs/orb.webp?v=orb) center / cover no-repeat, linear-gradient(135deg, #0b1030 0%, #1a1440 100%)",
  "groups": [
    {
      "name": "点阵球",
      "params": [
        {
          "key": "sigma",
          "label": "球体大小",
          "hint": "点阵球的整体尺寸",
          "min": 0.5,
          "max": 1.5,
          "step": 0.01,
          "default": 1,
          "format": "times"
        },
        {
          "key": "orbDesign",
          "label": "形态",
          "hint": "点云的几何排布",
          "default": 0,
          "options": [
            "球体",
            "环面",
            "双旋臂",
            "星轨盘",
            "晶格壳"
          ]
        },
        {
          "key": "autoCycle",
          "type": "bool",
          "label": "循环更换形态",
          "hint": "每隔一段时间自动切换点云形态；关掉后停留在当前形态",
          "default": true
        },
        {
          "key": "density",
          "label": "点密度",
          "hint": "同一形态下的点数",
          "min": 0.3,
          "max": 2,
          "step": 0.05,
          "default": 1,
          "format": "times"
        },
        {
          "key": "speed",
          "label": "旋转速度",
          "hint": "自转快慢；指针靠近时会加速",
          "min": 0,
          "max": 3,
          "step": 0.05,
          "default": 1,
          "format": "times"
        },
        {
          "key": "hoverReaction",
          "label": "指针响应",
          "hint": "指针进入球内时自转加速的强度",
          "min": 0,
          "max": 2,
          "step": 0.05,
          "default": 1,
          "format": "times"
        },
        {
          "key": "glow",
          "label": "辉光强度",
          "hint": "点光的亮度（背景辉光不受此项控制）",
          "min": 0,
          "max": 1.5,
          "step": 0.05,
          "default": 0.8,
          "format": "percent"
        }
      ]
    }
  ],
