{
  "id": "beach",
  "name": "沙滩",
  "desc": "海岸线绕着你的文件弯曲，海浪一层层冲上沙滩",
  "page": "themes/beach/beach.html",
  "thumb": "url(/thumbs/beach.webp?v=017578bc5c) center / cover no-repeat, linear-gradient(160deg, #f6ecdf 0%, #f6ecdf 34%, #bfeee0 36%, #57cfd0 55%, #0f9fc4 78%, #0a86b0 100%)",
  "thumbSource": "custom",
  "groups": [
    {
      "name": "岸线",
      "params": [
        {
          "key": "sigma",
          "label": "离岸距离",
          "hint": "海岸线离图标多远",
          "min": 40,
          "max": 200,
          "step": 1,
          "default": 85,
          "unit": "px"
        },
        {
          "key": "warp",
          "label": "海岸曲折",
          "hint": "岸线弯弯绕绕的程度",
          "min": 0,
          "max": 80,
          "step": 1,
          "default": 34
        }
      ]
    },
    {
      "name": "海水",
      "params": [
        {
          "key": "shoal",
          "label": "透明浅滩",
          "hint": "能看见沙底的浅水有多宽",
          "min": 0,
          "max": 300,
          "step": 1,
          "default": 110,
          "unit": "px"
        },
        {
          "key": "shallow",
          "label": "浅海宽度",
          "hint": "从青绿过渡到深蓝的距离",
          "min": 120,
          "max": 700,
          "step": 1,
          "default": 260,
          "unit": "px"
        }
      ]
    },
    {
      "name": "元素",
      "params": [
        {
          "key": "palms",
          "label": "椰子树数量",
          "hint": "沿岸椰子树的数量，设为 0 可隐藏；沙地不足时会减少显示",
          "min": 0,
          "max": 10,
          "step": 1,
          "default": 4,
          "unit": "棵"
        },
        {
          "key": "kayaks",
          "label": "皮划艇",
          "min": 0,
          "max": 4,
          "step": 1,
          "default": 2,
          "unit": "艘"
        },
        {
          "key": "birds",
          "label": "海鸟",
          "hint": "在上空滑翔、盘旋的海鸥",
          "min": 0,
          "max": 8,
          "step": 1,
          "default": 3,
          "unit": "只"
        }
      ]
    }
  ],
