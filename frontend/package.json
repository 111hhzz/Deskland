{
  "name": "deskland-frontend",
  "version": "0.2.0",
  "private": true,
  "description": "Deskland+ 前端构建期工具（仅开发用，运行时无依赖）",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "tokens": "node scripts/build-tokens.mjs --emit",
    "tokens:check": "node scripts/build-tokens.mjs --check-all",
    "build": "pnpm tokens && tsc --noEmit && vp build",
    "check": "pnpm tokens:check && vp check --deny-warnings && pnpm test",
    "test": "vp test run",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "typecheck": "tsc --noEmit",
    "lint:css": "stylelint --config scripts/stylelint.config.mjs \"src/**/*.css\" \"public/themes/**/*.css\"",
    "thumbs": "node scripts/thumbs.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "sharp": "^0.35.5",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "typescript": "^7.0.2",
    "vite-plus": "^1.7.0",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.23.0"
}
