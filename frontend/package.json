{
  "name": "deskland-frontend",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Deskland+ 前端构建期工具（仅开发用，运行时无依赖）",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "sharp": "^0.35.5",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  },
  "scripts": {
    "dev": "vite --config scripts/vite.config.mjs",
    "build": "tsc --noEmit && vite build --config scripts/vite.config.mjs",
    "typecheck": "tsc --noEmit",
    "thumbs": "node scripts/thumbs.mjs",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint --config scripts/eslint.config.mjs .",
    "lint:css": "stylelint --config scripts/stylelint.config.mjs \"src/**/*.css\""
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
