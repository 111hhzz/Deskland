#!/bin/sh
# pre-push：推送前再次跑全量门禁（与提交时同一份，防止 --no-verify 后漏检）。
# 安装：pwsh -File tools/setup-hooks.ps1   （core.hooksPath=.githooks）

set -e

if ! command -v pwsh >/dev/null 2>&1; then
    echo "❌ 找不到 pwsh（PowerShell 7）：门禁脚本需要它，请安装后重试" >&2
    exit 1
fi

ROOT=$(git rev-parse --show-toplevel)
exec pwsh -NoProfile -ExecutionPolicy Bypass -File "$ROOT/tools/ci/run-gates.ps1" -Stage All
