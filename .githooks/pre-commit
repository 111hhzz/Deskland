#!/bin/sh
# pre-commit hook：lint → typecheck → deslop → test
# 安装：cp .githooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -e

# 加载 .NET SDK 路径（硬编码，避免环境变量问题）
export PATH="/c/Users/huang/AppData/Local/Microsoft/dotnet:$PATH"

echo "════════════════════════════════════════════════════════════"
echo "  pre-commit: 代码质量门禁"
echo "════════════════════════════════════════════════════════════"
echo ""

# ─── 1. 前端门禁：token 同步 + Oxfmt + Oxlint(类型感知) ──────────
echo "▶ [1/5] Frontend: pnpm run check"
cd frontend
if ! pnpm run check 2>&1; then
    echo ""
    echo "❌ 前端门禁失败（token 产物同步 / 格式 / lint / 类型）"
    echo "   修复命令: cd frontend && pnpm tokens && pnpm exec vp check --fix"
    exit 1
fi
cd ..
echo "   ✅ 前端门禁通过"
echo ""

# ─── 2. Lint: dotnet format ───────────────────────────────────
echo "▶ [2/5] Lint: dotnet format --verify-no-changes"
if ! dotnet format Deskland.sln --verify-no-changes --verbosity quiet 2>&1; then
    echo ""
    echo "❌ Lint 失败：代码格式不符合规范"
    echo "   修复命令: dotnet format Deskland.sln"
    exit 1
fi
echo "   ✅ 格式检查通过"
echo ""

# ─── 3. Typecheck: dotnet build --warnaserror ─────────────────
echo "▶ [3/5] Typecheck: dotnet build --warnaserror"
cd host
# 不要用 `| tee`：管道的退出码取 tee 的，会掩盖编译失败
powershell -ExecutionPolicy Bypass -File build.ps1 > /tmp/deskland-build.log 2>&1
if [ $? -ne 0 ]; then
    cat /tmp/deskland-build.log
    echo ""
    echo "❌ 编译失败"
    exit 1
fi
cat /tmp/deskland-build.log
cd ..

cd test/Deskland.Tests
if ! dotnet build --no-restore --warnaserror 2>&1; then
    echo ""
    echo "❌ Typecheck 失败：存在编译警告"
    exit 1
fi
cd ../..
echo "   ✅ 类型检查通过"
echo ""

# ─── 4. Deslop: 自定义屎山代码检查 ─────────────────────────────
echo "▶ [4/5] Deslop: 屎山代码检查"

DESLOP_FOUND=0

# 检查 TODO/FIXME/HACK/XXX 注释（排除 bin/obj/.playwright 和 .md/.json）
echo "   检查 TODO/FIXME/HACK/XXX..."
DESLOP_HITS=$(grep -rn --include="*.cs" --include="*.html" --include="*.js" \
    --exclude-dir="bin" --exclude-dir="obj" --exclude-dir=".playwright" \
    -E "//\s*(TODO|FIXME|HACK|XXX|BUG|临时|暂时|先这样)" \
    host/ frontend/src/ test/ 2>/dev/null || true)
if [ -n "$DESLOP_HITS" ]; then
    echo "   ⚠️  发现待办注释："
    echo "$DESLOP_HITS" | head -5 | sed 's/^/      /'
    DESLOP_FOUND=1
fi

# 检查调试输出 Console.WriteLine / System.Diagnostics.Debug.WriteLine
# 排除测试项目和 Probe（它们用 Console.WriteLine 输出报告是正常的）
echo "   检查调试输出..."
DEBUG_HITS=$(grep -rn --include="*.cs" \
    --exclude-dir="bin" --exclude-dir="obj" --exclude-dir=".playwright" \
    -E "(Console\.WriteLine|System\.Diagnostics\.Debug\.WriteLine)" \
    host/ 2>/dev/null | grep -v "Log\." || true)
if [ -n "$DEBUG_HITS" ]; then
    echo "   ⚠️  发现调试输出："
    echo "$DEBUG_HITS" | head -5 | sed 's/^/      /'
    DESLOP_FOUND=1
fi

# 检查空 catch 块：catch 的 {} 内只有空白即违规（// 理由注释豁免）。
# 检测器 = tools/deslop-catch.awk（词法状态机跳过字符串/注释后配平花括号）。
# 老实现 grep -A1 "catch" | grep -B1 '^\s*}$' 只匹配多行写法，对本仓库通行的单行 `catch { }` 完全无效。
echo "   检查空 catch 块..."
if ! command -v awk >/dev/null 2>&1; then
    echo "   ⚠️  找不到 awk，无法检查空 catch"
    DESLOP_FOUND=1
else
    EMPTY_CATCH=""
    for f in host/*.cs; do
        [ -f "$f" ] || continue
        case "$f" in */bin/* | */obj/*) continue ;; esac
        EMPTY_CATCH="$EMPTY_CATCH$(awk -f tools/deslop-catch.awk "$f")"
    done
fi
if [ -n "$EMPTY_CATCH" ]; then
    echo "   ⚠️  发现空 catch 块："
    echo "$EMPTY_CATCH" | head -5 | sed 's/^/      /'
    DESLOP_FOUND=1
fi

# 检查未使用的变量（简单检查：声明后未使用）
echo "   检查敏感信息泄露..."
SECRET_HITS=$(grep -rn --include="*.cs" --include="*.json" --include="*.html" --include="*.js" \
    -E "(password\s*=\s*[\"'][^\"']+[\"']|secret\s*=\s*[\"'][^\"']+[\"']|token\s*=\s*[\"'][^\"']+[\"'])" \
    host/ frontend/src/ test/ 2>/dev/null | grep -v "example\|placeholder\|sample\|\.md" || true)
if [ -n "$SECRET_HITS" ]; then
    echo "   ⚠️  发现硬编码敏感信息："
    echo "$SECRET_HITS" | head -5 | sed 's/^/      /'
    DESLOP_FOUND=1
fi

# 检查 PowerShell 脚本编码：无 UTF-8 BOM 时 PowerShell 5.1 会按系统 ANSI 解析，中文导致 ParserError
echo "   检查 PowerShell 脚本编码..."
# 只检查 git 跟踪的脚本（避免扫到 bin/obj 下的构建产物）
BOM_MISSING=$(git ls-files -z -- '*.ps1' | while IFS= read -r -d '' f; do
  if [ "$(head -c 3 "$f" | od -An -tx1 | tr -d ' \n')" != "efbbbf" ]; then echo "$f"; fi
done)
if [ -n "$BOM_MISSING" ]; then
  echo "   ⚠️  缺少 UTF-8 BOM："
  echo "$BOM_MISSING" | head -5 | sed 's/^/      /'
  DESLOP_FOUND=1
fi

if [ "$DESLOP_FOUND" -eq 1 ]; then
    echo ""
    echo "❌ Deslop 失败：发现屎山代码"
    echo "   请清理后重新提交"
    exit 1
fi
echo "   ✅ Deslop 检查通过"
echo ""

# ─── 5. Test: dotnet test ─────────────────────────────────────
echo "▶ [5/5] Test: dotnet test"
cd test/Deskland.Tests
if ! dotnet test --no-build 2>&1; then
    echo ""
    echo "❌ 测试失败"
    exit 1
fi
cd ../..
echo "   ✅ 测试通过"
echo ""

echo "════════════════════════════════════════════════════════════"
echo "  ✅ 全部检查通过，允许提交"
echo "════════════════════════════════════════════════════════════"
